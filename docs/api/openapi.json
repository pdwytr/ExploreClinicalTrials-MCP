        "title": "QueryRequest",
        "description": "Request body for POST /query.\n\nOnly `query` is required. Structured fields, when given, take precedence\nover anything the system infers from the question text.",
        "examples": [
          {
            "drug_name": "Pembrolizumab",
            "query": "How has the number of trials for this drug changed over time?"
          }
        ]
      },
      "QueryResponse": {
        "properties": {
          "visualization": {
            "oneOf": [
