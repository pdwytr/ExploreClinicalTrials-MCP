                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Drug Name",
            "description": "Intervention / drug name, e.g. 'Pembrolizumab'."
          },
          "condition": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Condition",
            "description": "Condition or disease, e.g. 'non-small cell lung cancer'."
          },
          "trial_phase": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/TrialPhase"
                },
                "type": "array",
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Trial Phase",
            "description": "Restrict to these phases."
          },
          "sponsor": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Sponsor",
            "description": "Lead sponsor name, e.g. 'Merck Sharp & Dohme LLC'."
          },
          "country": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 2
              },
              {
                "type": "null"
              }
